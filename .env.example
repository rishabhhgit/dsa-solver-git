APP_ADMIN_PASSWORD=change-this
ADMIN_SESSION_SECRET=change-this-too-a-long-random-string
PUBLIC_BASE_URL=https://YOUR-DOMAIN.com

PUBLIC_MODEL_NAME=dsa-solver
PUBLIC_PROVIDER_NAME=DSA Practice Solver

MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

GEMINI_API_KEY=
GEMINI_MODEL=

MAX_IMAGES=10
MAX_IMAGE_SIZE_MB=10

REQUEST_TIMEOUT_SECONDS=180

ENABLE_VERIFICATION=false

ALLOWED_ORIGINS=

DATA_DIR=data

# Optional. Set this on hosts with no persistent disk (e.g. Render free
# tier) so the client-facing API key is stable across every redeploy
# instead of regenerating. Generate a value with:
#   python3 -c "import secrets; print('dsa_sk_' + secrets.token_urlsafe(32))"
# Leave blank to fall back to the file-persisted key in DATA_DIR (fine for
# local dev or Docker with a real mounted volume).
PROVIDER_API_KEY=
